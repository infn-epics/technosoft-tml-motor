  <!-- ==================== CONTROL BUTTONS ==================== -->
  <widget type="group" version="3.0.0">
    <name>grp_control</name>
    <x>10</x>
    <y>335</y>
    <width>660</width>
    <height>55</height>
    <style>1</style>
    <foreground_color>
      <color red="0" green="50" blue="100"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>lbl_ctl_title</name>
      <text>Control</text>
      <x>5</x>
      <y>0</y>
      <width>80</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="BOLD" size="13.0"/></font>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_stop</name>
      <actions>
        <action type="write_pv">
          <description>STOP</description>
          <pv_name>$(P)$(M).STOP</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>STOP</text>
      <x>5</x>
      <y>20</y>
      <width>80</width>
      <height>30</height>
      <font><font family="Liberation Sans" style="BOLD" size="14.0"/></font>
      <foreground_color><color red="255" green="255" blue="255"/></foreground_color>
      <background_color><color red="220" green="30" blue="30"/></background_color>
      <tooltip>$(actions)</tooltip>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_homf</name>
      <actions>
        <action type="write_pv">
          <description>Home Forward</description>
          <pv_name>$(P)$(M).HOMF</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Home Fwd</text>
      <x>100</x>
      <y>20</y>
      <width>90</width>
      <height>30</height>
      <tooltip>$(actions)</tooltip>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_homr</name>
      <actions>
        <action type="write_pv">
          <description>Home Reverse</description>
          <pv_name>$(P)$(M).HOMR</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Home Rev</text>
      <x>200</x>
      <y>20</y>
      <width>90</width>
      <height>30</height>
      <tooltip>$(actions)</tooltip>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_enable</name>
      <text>Motor:</text>
      <x>310</x>
      <y>24</y>
      <width>55</width>
      <height>22</height>
      <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>cmb_able</name>
      <pv_name>$(P)$(M)_able</pv_name>
      <x>365</x>
      <y>22</y>
      <width>110</width>
      <height>26</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_cnen</name>
      <text>Closed Loop:</text>
      <x>490</x>
      <y>24</y>
      <width>95</width>
      <height>22</height>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>cmb_cnen</name>
      <pv_name>$(P)$(M).CNEN</pv_name>
      <x>590</x>
      <y>22</y>
      <width>60</width>
      <height>26</height>
    </widget>
  </widget>

  <!-- ==================== MOTOR STATUS (MSTA) ==================== -->
  <widget type="group" version="3.0.0">
    <name>grp_msta</name>
    <x>10</x>
    <y>400</y>
    <width>660</width>
    <height>120</height>
    <style>1</style>
    <foreground_color>
      <color red="0" green="50" blue="100"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>lbl_msta_title</name>
      <text>Motor Status (MSTA)</text>
      <x>5</x>
      <y>0</y>
      <width>200</width>
      <height>20</height>
      <font><font family="Liberation Sans" style="BOLD" size="13.0"/></font>
    </widget>

    <!-- Row 1 -->
    <widget type="led" version="2.0.0">
      <name>led_dmov</name>
      <pv_name>$(P)$(M).DMOV</pv_name>
      <x>5</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="0" green="200" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_dmov</name>
      <text>Done Moving</text>
      <x>28</x>
      <y>25</y>
      <width>90</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_movn</name>
      <pv_name>$(P)$(M).MOVN</pv_name>
      <x>130</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="255" green="200" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_movn</name>
      <text>Moving</text>
      <x>153</x>
      <y>25</y>
      <width>70</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_athm</name>
      <pv_name>$(P)$(M).ATHM</pv_name>
      <x>240</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="0" green="200" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_athm</name>
      <text>At Home</text>
      <x>263</x>
      <y>25</y>
      <width>70</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_homed</name>
      <pv_name>=$(P)$(M).MSTA&amp;15</pv_name>
      <bit>15</bit>
      <x>350</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="0" green="200" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_homed</name>
      <text>Homed</text>
      <x>373</x>
      <y>25</y>
      <width>60</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_direction</name>
      <pv_name>=$(P)$(M).MSTA&amp;9</pv_name>
      <bit>9</bit>
      <x>450</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="0" green="180" blue="255"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_direction</name>
      <text>Direction +</text>
      <x>473</x>
      <y>25</y>
      <width>80</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_hasenc</name>
      <pv_name>=$(P)$(M).MSTA&amp;2</pv_name>
      <bit>2</bit>
      <x>570</x>
      <y>25</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="0" green="200" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_hasenc</name>
      <text>Encoder</text>
      <x>593</x>
      <y>25</y>
      <width>60</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <!-- Row 2 -->
    <widget type="led" version="2.0.0">
      <name>led_hls</name>
      <pv_name>$(P)$(M).HLS</pv_name>
      <x>5</x>
      <y>48</y>
      <width>18</width>
      <height>18</height>
      <on_color><color red="255" green="0" blue="0"/></on_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_hls</name>
      <text>High Limit</text>
      <x>28</x>
      <y>48</y>
      <width>90</width>
      <height>18</height>
      <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
    </widget>

    <widget type="led" version="2.0.0">
      <name>led_lls</name>
      <pv_name>$(P)$(M).LLS</pv_name>
      <x>130</x>
      <y>48</y>
