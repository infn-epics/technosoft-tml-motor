<?xml version="1.0" encoding="UTF-8"?>
<!--
  TmlMotorFull.bob — Full-featured Technosoft TML motor detail display
  Macros: P (PV prefix), M (motor name)
  Author: Andrea Michelotti — INFN-LNF
-->
<display version="2.0.0">
  <name>TML Motor - $(P)$(M)</name>
  <macros>
    <P>$(P)</P>
    <M>$(M)</M>
  </macros>
  <width>680</width>
  <height>1320</height>
  <background_color>
    <color red="240" green="240" blue="240"/>
  </background_color>

  <!-- ==================== TITLE BAR ==================== -->
  <widget type="rectangle" version="2.0.0">
    <name>title_bar</name>
    <x>0</x>
    <y>0</y>
    <width>680</width>
    <height>50</height>
    <line_color>
      <color red="0" green="50" blue="100"/>
    </line_color>
    <background_color>
      <color red="0" green="70" blue="140"/>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>title</name>
    <text>Technosoft TML Motor — $(P)$(M)</text>
    <x>10</x>
    <y>5</y>
    <width>500</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="18.0"/>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255"/>
    </foreground_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>desc</name>
    <pv_name>$(P)$(M).DESC</pv_name>
    <x>520</x>
    <y>10</y>
    <width>150</width>
    <height>28</height>
    <foreground_color>
      <color red="200" green="220" blue="255"/>
    </foreground_color>
    <background_color>
      <color red="0" green="70" blue="140"/>
    </background_color>
    <transparent>true</transparent>
  </widget>

  <!-- ==================== POSITION GROUP ==================== -->
  <widget type="group" version="3.0.0">
    <name>grp_position</name>
    <x>10</x>
    <y>60</y>
    <width>660</width>
    <height>155</height>
    <style>1</style>
    <foreground_color>
      <color red="0" green="50" blue="100"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>lbl_pos_title</name>
      <text>Position</text>
      <x>5</x>
      <y>0</y>
      <width>120</width>
      <height>20</height>
      <font><font family="Liberation Sans" style="BOLD" size="13.0"/></font>
    </widget>

    <!-- Readback Value (RBV) -->
    <widget type="label" version="2.0.0">
      <name>lbl_rbv</name>
      <text>Readback (RBV):</text>
      <x>5</x>
      <y>25</y>
      <width>135</width>
      <height>25</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_rbv</name>
      <pv_name>$(P)$(M).RBV</pv_name>
      <x>145</x>
      <y>25</y>
      <width>180</width>
      <height>25</height>
      <font><font family="Liberation Mono" style="BOLD" size="14.0"/></font>
      <foreground_color>
        <color red="0" green="0" blue="200"/>
      </foreground_color>
      <rules>
        <rule name="bg_moving" prop_id="background_color" out_exp="false">
          <exp boolExp="pv0==0">
            <color red="255" green="200" blue="200"/>
          </exp>
          <exp boolExp="pv0!=0">
            <color red="200" green="255" blue="200"/>
          </exp>
          <pv_name>$(P)$(M).DMOV</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_egu_rbv</name>
      <pv_name>$(P)$(M).EGU</pv_name>
      <x>330</x>
      <y>25</y>
      <width>60</width>
      <height>25</height>
    </widget>

    <!-- Dial Readback (DRBV) -->
    <widget type="label" version="2.0.0">
      <name>lbl_drbv</name>
      <text>Dial RBV (DRBV):</text>
      <x>400</x>
      <y>25</y>
      <width>130</width>
      <height>25</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_drbv</name>
      <pv_name>$(P)$(M).DRBV</pv_name>
      <x>535</x>
      <y>25</y>
      <width>115</width>
      <height>25</height>
    </widget>

    <!-- Target Value (VAL) -->
    <widget type="label" version="2.0.0">
      <name>lbl_val</name>
      <text>Target (VAL):</text>
      <x>5</x>
      <y>55</y>
      <width>135</width>
      <height>25</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_val</name>
      <pv_name>$(P)$(M).VAL</pv_name>
      <x>145</x>
      <y>55</y>
      <width>180</width>
      <height>25</height>
    </widget>

    <!-- Dial Target (DVAL) -->
    <widget type="label" version="2.0.0">
      <name>lbl_dval</name>
      <text>Dial Target (DVAL):</text>
      <x>400</x>
      <y>55</y>
      <width>130</width>
      <height>25</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_dval</name>
      <pv_name>$(P)$(M).DVAL</pv_name>
      <x>535</x>
      <y>55</y>
      <width>115</width>
      <height>25</height>
    </widget>

    <!-- Encoder Position (APOS) -->
    <widget type="label" version="2.0.0">
      <name>lbl_apos</name>
      <text>Encoder (APOS):</text>
      <x>5</x>
      <y>85</y>
      <width>135</width>
      <height>25</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_apos</name>
      <pv_name>$(P)$(M):APOS</pv_name>
      <x>145</x>
      <y>85</y>
      <width>180</width>
      <height>25</height>
      <font><font family="Liberation Mono" style="REGULAR" size="12.0"/></font>
    </widget>

    <!-- Commanded Speed (CSPD) -->
    <widget type="label" version="2.0.0">
      <name>lbl_cspd</name>
      <text>Cmd Speed (CSPD):</text>
      <x>400</x>
      <y>85</y>
      <width>130</width>
      <height>25</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_cspd</name>
      <pv_name>$(P)$(M):CSPD</pv_name>
      <x>535</x>
      <y>85</y>
      <width>115</width>
      <height>25</height>
    </widget>

    <!-- Tweak control -->
    <widget type="action_button" version="3.0.0">
      <name>btn_twr</name>
      <actions>
        <action type="write_pv">
          <description>Tweak Reverse</description>
          <pv_name>$(P)$(M).TWR</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>&lt;&lt;</text>
      <x>5</x>
      <y>120</y>
      <width>60</width>
      <height>28</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_twv</name>
      <pv_name>$(P)$(M).TWV</pv_name>
      <x>75</x>
      <y>120</y>
      <width>120</width>
      <height>28</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>btn_twf</name>
      <actions>
        <action type="write_pv">
          <description>Tweak Forward</description>
          <pv_name>$(P)$(M).TWF</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>&gt;&gt;</text>
      <x>205</x>
      <y>120</y>
      <width>60</width>
      <height>28</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_twv</name>
      <text>Tweak Step</text>
      <x>275</x>
      <y>123</y>
      <height>22</height>
    </widget>

    <!-- Set position -->
    <widget type="label" version="2.0.0">
      <name>lbl_set_use</name>
      <text>Set/Use:</text>
      <x>400</x>
      <y>123</y>
      <width>60</width>
      <height>22</height>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>cmb_set</name>
      <pv_name>$(P)$(M).SET</pv_name>
      <x>465</x>
      <y>120</y>
      <width>80</width>
      <height>26</height>
    </widget>
  </widget>

  <!-- ==================== VELOCITY & MOTION GROUP ==================== -->
  <widget type="group" version="3.0.0">
    <name>grp_velocity</name>
    <x>10</x>
    <y>225</y>
    <width>660</width>
    <height>100</height>
    <style>1</style>
    <foreground_color>
      <color red="0" green="50" blue="100"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>lbl_vel_title</name>
      <text>Velocity / Motion</text>
      <x>5</x>
      <y>0</y>
      <width>200</width>
      <height>20</height>
      <font><font family="Liberation Sans" style="BOLD" size="13.0"/></font>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_velo</name>
      <text>Velocity (VELO):</text>
      <x>5</x>
      <y>25</y>
      <width>130</width>
      <height>22</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_velo</name>
      <pv_name>$(P)$(M).VELO</pv_name>
      <x>140</x>
      <y>25</y>
      <width>100</width>
      <height>22</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_vbas</name>
      <text>Base Vel (VBAS):</text>
      <x>250</x>
      <y>25</y>
      <width>120</width>
      <height>22</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_vbas</name>
      <pv_name>$(P)$(M).VBAS</pv_name>
      <x>370</x>
      <y>25</y>
      <width>80</width>
      <height>22</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_vmax</name>
      <text>VMAX:</text>
      <x>470</x>
      <y>25</y>
      <width>55</width>
      <height>22</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_vmax</name>
      <pv_name>$(P)$(M).VMAX</pv_name>
      <x>530</x>
      <y>25</y>
      <width>120</width>
      <height>22</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_accs</name>
      <text>Accel time (ACCS):</text>
      <x>5</x>
      <y>52</y>
      <width>130</width>
      <height>22</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_accs</name>
      <pv_name>$(P)$(M).ACCS</pv_name>
      <x>140</x>
      <y>52</y>
      <width>100</width>
      <height>22</height>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lbl_s</name>
      <text>seconds</text>
      <x>245</x>
      <y>52</y>
      <width>60</width>
      <height>22</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_mres</name>
      <text>Resolution (MRES):</text>
      <x>340</x>
      <y>52</y>
      <width>135</width>
      <height>22</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>txt_mres</name>
      <pv_name>$(P)$(M).MRES</pv_name>
      <x>480</x>
      <y>52</y>
      <width>100</width>
      <height>22</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>lbl_bdst</name>
      <text>Backlash (BDST):</text>
      <x>5</x>
      <y>77</y>
      <width>130</width>
      <height>22</height>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>ent_bdst</name>
      <pv_name>$(P)$(M).BDST</pv_name>
      <x>140</x>
      <y>77</y>
      <width>100</width>
