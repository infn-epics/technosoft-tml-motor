  <!-- ==================== TML COMMANDS ==================== -->
  <widget type="group" version="3.0.0">
    <name>grp_commands</name>
    <x>10</x>
    <y>805</y>
    <width>660</width>
    <height>70</height>
    <style>1</style>
    <foreground_color>
      <color red="0" green="50" blue="100"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>lbl_cmd_title</name>
      <text>TML Commands</text>
      <x>5</x>
      <y>0</y>
      <width>200</width>
      <height>20</height>
      <font><font family="Liberation Sans" style="BOLD" size="13.0"/></font>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_rstfault</name>
      <actions>
        <action type="write_pv">
          <description>Reset drive faults (FAULTR)</description>
          <pv_name>$(P)$(M):CMD:RSTFAULT</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Reset Faults</text>
      <x>5</x>
      <y>25</y>
      <width>120</width>
      <height>35</height>
      <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
      <foreground_color><color red="255" green="255" blue="255"/></foreground_color>
      <background_color><color red="200" green="100" blue="0"/></background_color>
      <tooltip>$(actions)</tooltip>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_save</name>
      <actions>
        <action type="write_pv">
          <description>Save parameters to EEPROM</description>
          <pv_name>$(P)$(M):CMD:SAVE</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Save EEPROM</text>
      <x>140</x>
      <y>25</y>
      <width>120</width>
      <height>35</height>
      <tooltip>$(actions)</tooltip>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>btn_reset</name>
      <actions>
        <action type="write_pv">
          <description>Reset (reboot) the drive</description>
          <pv_name>$(P)$(M):CMD:RESET</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Reset Drive</text>
      <x>275</x>
      <y>25</y>
      <width>120</width>
      <height>35</height>
      <foreground_color><color red="255" green="255" blue="255"/></foreground_color>
      <background_color><color red="180" green="0" blue="0"/></background_color>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>

