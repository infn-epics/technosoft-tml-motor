  <widget type="group" version="3.0.0">
    <name>grp_control</name>
    <x>10</x>
    <y>335</y>
    <width>500</width>
    <height>55</height>
    <style>1</style>
    <widget type="action_button" version="3.0.0">
      <name>btn_stop</name>
      <actions>
        <action type="write_pv">
          <description>Stop Motor</description>
          <pv_name>$(P)$(M).STOP</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>STOP</text>
      <x>5</x>
      <y>5</y>
      <width>80</width>
      <height>35</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="220" green="30" blue="30">
        </color>
      </background_color>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>btn_homf</name>
      <actions>
        <action type="write_pv">
          <description>Home Forward</description>
          <pv_name>$(P)$(M).HOMF</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Home Fwd</text>
      <x>100</x>
      <y>5</y>
      <width>90</width>
      <height>35</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>btn_homr</name>
      <actions>
        <action type="write_pv">
          <description>Home Reverse</description>
          <pv_name>$(P)$(M).HOMR</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Home Rev</text>
      <x>200</x>
      <y>5</y>
      <width>90</width>
      <height>35</height>
      <tooltip>$(actions)</tooltip>
    </widget>
