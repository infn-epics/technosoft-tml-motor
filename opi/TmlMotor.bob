  <widget type="group" version="3.0.0">
    <name>grp_tweak</name>
    <x>10</x>
    <y>190</y>
    <width>500</width>
    <height>45</height>
    <style>1</style>
    <widget type="action_button" version="3.0.0">
      <name>btn_twr</name>
      <actions>
        <action type="write_pv">
          <description>Tweak Reverse</description>
          <pv_name>$(P)$(M).TWR</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>&lt;&lt;</text>
      <x>5</x>
      <y>5</y>
      <width>60</width>
      <height>28</height>
      <tooltip>$(actions)</tooltip>
    </widget>
